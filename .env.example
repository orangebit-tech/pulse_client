INSTANCE_TYPE=web-server
DOMAIN=pulse.orangebit.dev
HEALTH_PORT=9443
ENABLE_CERT_CHECK=true
MASTER_URL=https://pulse.orangebit.dev:3000
HOST_REG_TOKEN=replace_me
HOST_KEY=host-001
METRICS_INTERVAL_MS=10000
INCLUDE_DOCKER_CONTAINERS=false
DOCKER_CONTAINERS_LIMIT=20
DOCKER_CONTAINERS_INTERVAL_MS=60000
INCLUDE_PROCESSES=true
PROCESSES_LIMIT=50
NODE_PROCESSES_LIMIT=50
PROCESSES_INTERVAL_MS=30000
PROCESS_COMMAND_MAX_LENGTH=240

# Storage telemetry. Distinguishes reclaimable garbage from ghost space
# (deleted-but-open files) from real data — see CONTRACT.md.
INCLUDE_STORAGE=true
STORAGE_INTERVAL_MS=300000
STORAGE_DEEP_INTERVAL_MS=21600000
STORAGE_TOP_DIRS_LIMIT=15
STORAGE_TOP_DIRS_DEPTH=2
STORAGE_TOP_HOLDERS_LIMIT=5
STORAGE_TOP_LOGS_LIMIT=10
STORAGE_GHOST_MIN_BYTES=1048576
STORAGE_DU_TIMEOUT_MS=120000
# Where the host root is bind-mounted into the agent container. Auto-detected
# as /hostfs when present, otherwise the agent's own root.
# STORAGE_ROOTFS=/hostfs
RESOURCE_REPORTING_ENABLED=false
RESOURCE_REPORT_INTERVAL_MS=30000
# RESOURCE_DEFINITIONS_PATH=/etc/pulse/resources.json
# RESOURCE_DEFINITIONS_JSON=[{"resourceKey":"my-app","type":"service","provider":"docker","name":"My App","stateJson":{"containerName":"my-app"}}]

# Provider mode is disabled by default. When true, this agent can provision
# Proxmox VM/LXC guests for the orchestrator.
PROVIDER_MODE=false
COMMAND_AUTH_TOKEN=openssl rand -base64 32
PROXMOX_API_URL=
PROXMOX_API_TOKEN_ID=
PROXMOX_API_TOKEN_SECRET=
PROXMOX_NODE=
PROVISION_DEFAULT_STORAGE=nvme-fast
PROVISION_VM_TEMPLATE=
PROVISION_LXC_TEMPLATE=
